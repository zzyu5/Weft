#   OBJD TILED   -O2  vsetvli=87   spill=7    reload=12   vwmacc=2304  maxVreg=v30  textB=26968
#   OBJD UNTILED -O3  vsetvli=76   spill=603  reload=730  vwmacc=2304  maxVreg=v31  textB=47796
