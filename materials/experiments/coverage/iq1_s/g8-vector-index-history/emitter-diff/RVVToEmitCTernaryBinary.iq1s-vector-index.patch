+      // [G8 §六.3 vector grid-index primitive] Synthesize the 4 grid byte-offset
+      // indices ENTIRELY in vector registers -- NO uint16_t tmp[4] stack scratch,
+      // NO scalar index chain, NO vle16 read-back. Byte-identical, per lane l, to
+      // the scalar form  idx = qs[ib*4+l] | (((qhw>>(3*l))&7)<<8),  vidx = idx<<3;
+      // the 4 lanes are assembled with vid/vmul/vsrl.vv/vand/vsll/vor mirroring the
+      // opponent's all-vector index assembly (raw/opp_iq1s_vl128.s .LBB29_4). The
+      // synthesized vuint16mf2_t is the u16-EEW gather index (EMUL = (16/64)*2 =
+      // 1/2 -> mf2 for the i64m2 gather).
+      mlir::Type u8mf4Type = emitc::OpaqueType::get(ctx, "vuint8mf4_t");
+      // qsGroup = qs + ib*4;  ONE vle8 u8mf4 loads this sub-block's 4 qs index
+      // bytes (contiguous), then vzext.vf2 widens to the u16 low index bits.
+      mlir::Value qsGroupPtr =
+          (ib == 0)
+              ? qsBase
+              : rewriter
+                    .create<emitc::AddOp>(loc, u8PtrType, qsBase,
+                                          sizeLit(ib * groupsPerSub))
+                    .getResult();
+      std::string qsLoadCallee = riscvIntrinsicName("vle", 8, "mf4", "u8");
+      mlir::Value qsBytes = emitOpaqueCall(
+          rewriter, loc, u8mf4Type, qsLoadCallee,
+          mlir::ValueRange{qsGroupPtr, sizeLit(groupsPerSub)}, opName, role,
+          llvm::StringRef("ternary_grid_index_vector"));
+      mlir::Value qsU16 = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vzext_vf2_u16mf2",
+          mlir::ValueRange{qsBytes, sizeLit(groupsPerSub)}, opName, role);
+      // qhwSplat = broadcast(qhw) over 4 lanes;  vid = [0,1,2,3];
+      // shiftVec = vid*3 = [0,3,6,9]  (the per-lane 3*l qh shift amounts).
+      std::string vmvU16Callee = riscvIntrinsicName("vmv_v_x", 16, "mf2", "u16");
+      mlir::Value qhwSplat = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, vmvU16Callee,
+          mlir::ValueRange{qhWord, sizeLit(groupsPerSub)}, opName, role);
+      mlir::Value vidVec = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vid_v_u16mf2",
+          mlir::ValueRange{sizeLit(groupsPerSub)}, opName, role);
+      mlir::Value shiftVec = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vmul_vx_u16mf2",
+          mlir::ValueRange{vidVec, sizeLit(3), sizeLit(groupsPerSub)}, opName,
+          role);
+      // per-lane (qhw >> (3*l)) & 7, then << 8 = the high-3 index bits [8,10].
+      mlir::Value shifted = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vsrl_vv_u16mf2",
+          mlir::ValueRange{qhwSplat, shiftVec, sizeLit(groupsPerSub)}, opName,
+          role);
+      mlir::Value qhField = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vand_vx_u16mf2",
+          mlir::ValueRange{shifted, sizeLit(7), sizeLit(groupsPerSub)}, opName,
+          role);
+      mlir::Value qhHighBits = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vsll_vx_u16mf2",
+          mlir::ValueRange{qhField, sizeLit(8), sizeLit(groupsPerSub)}, opName,
+          role);
+      // idx = qs | qhHigh  (11-bit, [0,2047]);  vidx = idx << 3  (idx*8 byte off).
+      mlir::Value idxVec = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vor_vv_u16mf2",
+          mlir::ValueRange{qsU16, qhHighBits, sizeLit(groupsPerSub)}, opName,
+          role);
+      mlir::Value vidx = emitOpaqueCall(
+          rewriter, loc, u16mf2Type, "__riscv_vsll_vx_u16mf2",
+          mlir::ValueRange{idxVec, sizeLit(3), sizeLit(groupsPerSub)}, opName,
+          role);
 
